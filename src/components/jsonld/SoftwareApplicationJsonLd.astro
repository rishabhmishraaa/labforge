---
// SoftwareApplication JSON-LD, on "/" only (SPEC.md F8.3, F8.5).
// Description reuses the visible hero text, and offers come from the pricing data (F8.6); nothing is retyped here.
// Plans without a numeric price (Enterprise, "Contact us") are left out of `offers` (D10).
import JsonLd from './JsonLd.astro';
import { hero } from '../../data/home';
import { plans } from '../../data/pricing';

if (!Astro.site) {
	throw new Error('SoftwareApplicationJsonLd: set `site` in astro.config.mjs.');
}

const offers = plans
	.filter((plan) => plan.monthlyPriceUsd !== null)
	.map((plan) => ({
		'@type': 'Offer',
		name: plan.name,
		price: String(plan.monthlyPriceUsd),
		priceCurrency: 'USD',
	}));
---

<JsonLd
	data={{
		'@type': 'SoftwareApplication',
		name: 'LabForge',
		description: hero.text,
		url: new URL('/', Astro.site).href,
		// Labs are hands-on training environments that launch in the browser (Product facts).
		applicationCategory: 'EducationalApplication',
		operatingSystem: 'Web browser',
		offers,
	}}
/>
