---
import { steps } from '../../data/steps';
---

<section id="how-it-works" aria-labelledby="how-it-works-title" class="mt-16 sm:mt-20">
	<h2 id="how-it-works-title" class="text-2xl font-bold tracking-tight sm:text-3xl">How it works</h2>
	<ol class="mt-8 grid gap-6 sm:grid-cols-3">
		{
			steps.map((step, index) => (
				<li class="flex gap-4 sm:flex-col">
					<span
						aria-hidden="true"
						class="flex size-10 shrink-0 items-center justify-center rounded-full bg-indigo-600 font-bold text-white dark:bg-indigo-400 dark:text-slate-950"
					>
						{index + 1}
					</span>
					<div>
						<h3 class="text-lg font-semibold">{step.title}</h3>
						<p class="mt-1 text-slate-700 dark:text-slate-300">{step.description}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>
