---
import CtaLink from './CtaLink.astro';
import { hero, pricingCta } from '../../data/home';
---

<section id="hero" aria-labelledby="hero-title" class="py-8 sm:py-12">
	<h1 id="hero-title" class="max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">
		{hero.title}
	</h1>
	<p class="mt-6 max-w-2xl text-lg text-slate-700 dark:text-slate-300">{hero.text}</p>
	<div class="mt-8">
		<CtaLink cta={pricingCta} />
	</div>
</section>
