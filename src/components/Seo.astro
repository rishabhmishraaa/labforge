---
// All SEO and social-sharing tags for a page (SPEC.md F6). Absolute URLs come from `site` in astro.config.mjs.
import { normalizePath } from '../utils/paths';

interface Props {
	title: string;
	description: string;
	/**
	 * For pages that must not be indexed (the 404 page, SPEC.md F5.7). Adds a robots noindex tag and leaves out the
	 * canonical link (F6.4) and the social tags: og:url must equal the canonical, and these pages aren't meant to be shared.
	 */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

if (!Astro.site) {
	throw new Error('Seo.astro: set `site` in astro.config.mjs; canonical and Open Graph URLs depend on it.');
}

const canonical = new URL(normalizePath(Astro.url.pathname), Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{
	!noindex && (
		<>
			<link rel="canonical" href={canonical} />

			<meta property="og:type" content="website" />
			<meta property="og:site_name" content="LabForge" />
			<meta property="og:title" content={title} />
			<meta property="og:description" content={description} />
			<meta property="og:url" content={canonical} />
			<meta property="og:image" content={ogImage} />
			<meta property="og:image:width" content="1200" />
			<meta property="og:image:height" content="630" />
			<meta property="og:image:alt" content="LabForge: hands-on Azure and AWS labs that launch in the browser" />

			<meta name="twitter:card" content="summary_large_image" />
		</>
	)
}
