---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/pricing', label: 'Pricing' },
	{ href: '/about', label: 'About' },
];

// With build.format 'file', the path can end in ".html", so normalize before comparing.
function normalize(path: string): string {
	const trimmed = path.replace(/\.html$/, '').replace(/\/+$/, '');
	return trimmed === '' || trimmed === '/index' ? '/' : trimmed;
}

const currentPath = normalize(Astro.url.pathname);
const focusRing =
	'rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:focus-visible:outline-indigo-400';
---

<header class="border-b border-slate-200 dark:border-slate-800">
	<div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
		<a href="/" aria-label="LabForge home" class={`inline-flex items-center gap-2 text-lg font-bold ${focusRing}`}>
			<svg aria-hidden="true" viewBox="0 0 32 32" class="size-8">
				<rect width="32" height="32" rx="7" class="fill-indigo-600"></rect>
				<path d="M13 6h6v7l6 11a2 2 0 0 1-1.8 3H8.8A2 2 0 0 1 7 24l6-11z" class="fill-white"></path>
			</svg>
			<span>LabForge</span>
		</a>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			<nav aria-label="Main">
				<ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
					{
						navLinks.map(({ href, label }) => {
							const isCurrent = normalize(href) === currentPath;
							return (
								<li>
									<a
										href={href}
										aria-current={isCurrent ? 'page' : undefined}
										class={`inline-block px-1 py-1 ${focusRing} ${isCurrent ? 'font-semibold text-indigo-700 underline underline-offset-4 dark:text-indigo-300' : 'text-slate-700 hover:text-indigo-700 dark:text-slate-300 dark:hover:text-indigo-300'}`}
									>
										{label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>
			<ThemeToggle />
		</div>
	</div>
</header>
