import Features from '../components/home/Features.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<BaseLayout
	title="LabForge: Hands-on Azure and AWS labs in the browser"
	description="Ready-to-use Azure and AWS sandbox labs that launch in the browser for courses, workshops, and product demos, and auto-delete after a time limit."
>
	<Hero />
	<Features />
	<HowItWorks />
	<Testimonials />
	<Faq />
	<FinalCta />
</BaseLayout>
