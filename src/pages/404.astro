---
// Custom 404 page (SPEC.md F5.4–F5.7). `noindex` adds the robots tag and leaves out the canonical link (F6.4).
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaLink from '../components/home/CtaLink.astro';
---

<BaseLayout
	title="Page not found | LabForge"
	description="This page doesn't exist on the LabForge site. Go back to the home page, or use the navigation to find pricing and about."
	noindex
>
	<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
	<p class="mt-4 max-w-2xl text-lg text-slate-700 dark:text-slate-300">There is no page at this address.</p>
	<div class="mt-8">
		<CtaLink cta={{ label: 'Go to the home page', href: '/' }} />
	</div>
</BaseLayout>
